CompileFlags:
  CompilationDatabase: build
  Remove: [-include-pch, -Xclang, -include]
Completion:
  HeaderInsertion: Never
Index:
  StandardLibrary: Yes
---
If:
  PathMatch: '.*\.(h|hpp|cpp)$'
CompileFlags:
  Add:
    - -std=c++23
    - -xc++
    - -I../Engine/include
    - -I../Engine/lib
    - -I../Engine/lib/glm
    - -I../Engine/lib/glad/include
    - -I../Engine/lib/glfw/include
    - -I../Engine/lib/freetype/include